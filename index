<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>臺中惠民扶輪社｜扶輪日售票系統</title>
  <meta name="theme-color" content="#5B3F8C" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <style>
    body { -webkit-tap-highlight-color: transparent; }
    .safe-bottom { padding-bottom: max(24px, env(safe-area-inset-bottom)); }
    .ticket-shadow { box-shadow: 0 18px 50px rgba(57, 35, 92, .18); }
    .loading-dot { width:10px;height:10px;border-radius:50%;background:#6d5aa4;animation:b 0.7s infinite alternate; }
    .loading-dot:nth-child(2){animation-delay:.15s}.loading-dot:nth-child(3){animation-delay:.3s}
    @keyframes b { to { transform:translateY(-8px); opacity:.45; } }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen">
  <div id="root"></div>

  <script type="text/babel">
    const { useEffect, useMemo, useState } = React;

    const DEFAULT_API_URL = "https://script.google.com/macros/s/AKfycbwTBjHVnzYJW53_inuVIaMJ0JZYpChnKsHJQkAmTB9uvV8BQPBuVTcSxN67TycpDkt8/exec";
    const APP_VERSION = "v1.0.0";
    const USER_TOKEN_KEY = "huimin_rotaryday_user_token";
    const ADMIN_TOKEN_KEY = "huimin_rotaryday_admin_token";

    async function api(action, payload = {}) {
      const res = await fetch(DEFAULT_API_URL, {
        method: "POST",
        redirect: "follow",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify({ action, ...payload })
      });
      const json = await res.json();
      if (json.status === "error") throw new Error(json.message || "系統錯誤");
      return json;
    }

    const money = (n) => `NT$ ${Number(n || 0).toLocaleString("zh-TW")}`;
    const statusMap = {
      WAITING_PAYMENT: ["等待匯款", "bg-slate-100 text-slate-600"],
      PAYMENT_REPORTED: ["已回報・待執秘確認", "bg-amber-100 text-amber-700"],
      PAYMENT_ISSUE: ["款項需確認", "bg-rose-100 text-rose-700"],
      PAID: ["已確認・票券已成立", "bg-emerald-100 text-emerald-700"]
    };

    function Shell({children, config}) {
      return <div className="min-h-screen bg-gradient-to-b from-violet-50 via-white to-slate-50">
        <header className="bg-[#5B3F8C] text-white px-5 py-5 shadow-lg">
          <div className="max-w-3xl mx-auto">
            <div className="text-[11px] tracking-[.22em] uppercase text-white/70">Rotary Club of Taichung Huimin</div>
            <h1 className="text-2xl font-black mt-1">{config?.eventName || "臺中惠民扶輪社 扶輪日"}</h1>
          </div>
        </header>
        <main className="max-w-3xl mx-auto px-4 py-5 safe-bottom">{children}</main>
        <footer className="text-center text-[10px] text-slate-400 pb-8">臺中惠民扶輪社 · SYSTEM {APP_VERSION}</footer>
      </div>
    }

    function Loading({text="資料載入中..."}) {
      return <div className="fixed inset-0 z-50 bg-black/45 backdrop-blur-sm flex items-center justify-center p-6">
        <div className="bg-white rounded-3xl p-7 shadow-2xl w-full max-w-xs text-center">
          <div className="flex justify-center gap-2 mb-5"><div className="loading-dot"/><div className="loading-dot"/><div className="loading-dot"/></div>
          <div className="font-black text-slate-800">{text}</div>
        </div>
      </div>
    }

    function Notice({type="info", children}) {
      const cls = type === "error" ? "bg-rose-50 text-rose-700 border-rose-200" : type === "success" ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-indigo-50 text-indigo-700 border-indigo-200";
      return <div className={`border rounded-2xl p-4 text-sm font-bold ${cls}`}>{children}</div>
    }

    function TicketPublic({ticketId, token, config}) {
      const [data, setData] = useState(null);
      const [error, setError] = useState("");
      useEffect(() => {
        api("get_ticket_public", { ticketId, token }).then(r => setData(r.data)).catch(e => setError(e.message));
      }, [ticketId, token]);

      if (error) return <Shell config={config}><Notice type="error">{error}</Notice></Shell>;
      if (!data) return <Loading text="正在開啟入場券..." />;
      const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=500x500&data=${encodeURIComponent(data.ticketUrl)}`;

      return <Shell config={{...config, eventName:data.eventName}}>
        <div className="bg-white rounded-[2rem] ticket-shadow overflow-hidden border border-violet-100">
          <div className="bg-gradient-to-br from-[#5B3F8C] to-[#7964A9] text-white text-center px-6 py-8">
            <div className="text-xs tracking-[.25em] text-white/70 uppercase">Rotary Day</div>
            <h2 className="text-3xl font-black mt-2">{data.ticketTitle}</h2>
          </div>
          <div className="p-7 text-center">
            <div className="text-2xl font-black text-slate-900">{data.name}</div>
            <div className="mt-2 text-xs font-mono text-slate-400">{data.ticketId}</div>
            <img src={qrUrl} className="w-full max-w-[310px] aspect-square mx-auto mt-6 rounded-2xl border-8 border-white shadow-lg" alt="入場 QR Code" />
            <div className="mt-5 text-sm font-bold text-slate-600">活動當日請出示此 QR Code 供接待人員掃描</div>
            {(data.eventDate || data.eventTime || data.eventLocation) && <div className="mt-6 bg-slate-50 rounded-2xl p-4 text-sm text-left space-y-1">
              {data.eventDate && <div><b>日期：</b>{data.eventDate} {data.eventTime}</div>}
              {data.eventLocation && <div><b>地點：</b>{data.eventLocation}</div>}
            </div>}
            {data.isCheckedIn && <div className="mt-5 bg-emerald-50 text-emerald-700 rounded-xl p-3 font-black">✓ 已完成入場報到</div>}
          </div>
        </div>
      </Shell>;
    }

    function Auth({config, onAuthed}) {
      const [mode, setMode] = useState("login");
      const [step, setStep] = useState("form");
      const [loading, setLoading] = useState(false);
      const [error, setError] = useState("");
      const [masked, setMasked] = useState("");
      const [form, setForm] = useState({phone:"", name:"", title:"先生", email:"", code:""});
      const set = (k,v) => setForm(f=>({...f,[k]:v}));

      async function sendCode() {
        setError(""); setLoading(true);
        try {
          let r;
          if (mode === "register") {
            r = await api("start_register", {phone:form.phone,name:form.name,title:form.title,email:form.email});
            if (r.status === "exists") { setMode("login"); throw new Error(r.message); }
          } else {
            r = await api("start_login", {phone:form.phone});
            if (r.status === "not_found") { setMode("register"); throw new Error(r.message); }
          }
          setMasked(r.maskedEmail || "");
          setStep("otp");
        } catch(e) { setError(e.message); }
        finally { setLoading(false); }
      }

      async function verify() {
        setError(""); setLoading(true);
        try {
          const action = mode === "register" ? "verify_register" : "verify_login";
          const r = await api(action, {phone:form.phone,code:form.code});
          localStorage.setItem(USER_TOKEN_KEY, r.sessionToken);
          onAuthed(r.user, r.sessionToken);
        } catch(e) { setError(e.message); }
        finally { setLoading(false); }
      }

      return <Shell config={config}>
        {loading && <Loading text={step === "otp" ? "正在驗證..." : "正在寄送驗證碼..."} />}
        <div className="bg-white rounded-3xl shadow-sm border border-slate-100 p-6">
          <div className="flex bg-slate-100 rounded-2xl p-1 mb-6">
            <button onClick={()=>{setMode("login");setStep("form");setError("")}} className={`flex-1 py-3 rounded-xl font-black ${mode==="login"?"bg-white shadow text-[#5B3F8C]":"text-slate-400"}`}>手機登入</button>
            <button onClick={()=>{setMode("register");setStep("form");setError("")}} className={`flex-1 py-3 rounded-xl font-black ${mode==="register"?"bg-white shadow text-[#5B3F8C]":"text-slate-400"}`}>第一次建立帳號</button>
          </div>

          {error && <div className="mb-4"><Notice type="error">{error}</Notice></div>}

          {step === "form" ? <div className="space-y-4">
            <div>
              <label className="text-sm font-bold text-slate-600">手機號碼</label>
              <input value={form.phone} onChange={e=>set("phone",e.target.value)} inputMode="tel" placeholder="09xxxxxxxx" className="mt-1 w-full px-4 py-4 rounded-2xl border border-slate-200 outline-none focus:ring-2 focus:ring-violet-200 text-lg" />
            </div>
            {mode === "register" && <>
              <div>
                <label className="text-sm font-bold text-slate-600">姓名</label>
                <input value={form.name} onChange={e=>set("name",e.target.value)} className="mt-1 w-full px-4 py-4 rounded-2xl border border-slate-200 outline-none focus:ring-2 focus:ring-violet-200" />
              </div>
              <div>
                <label className="text-sm font-bold text-slate-600">稱謂</label>
                <div className="grid grid-cols-2 gap-3 mt-2">
                  {["先生","小姐"].map(t=><button key={t} onClick={()=>set("title",t)} className={`py-3 rounded-2xl border font-black ${form.title===t?"bg-violet-50 border-violet-300 text-[#5B3F8C]":"border-slate-200 text-slate-500"}`}>{t}</button>)}
                </div>
              </div>
              <div>
                <label className="text-sm font-bold text-slate-600">Email</label>
                <input value={form.email} onChange={e=>set("email",e.target.value)} inputMode="email" placeholder="收據與入場券將寄到這裡" className="mt-1 w-full px-4 py-4 rounded-2xl border border-slate-200 outline-none focus:ring-2 focus:ring-violet-200" />
              </div>
            </>}
            <button onClick={sendCode} className="w-full py-4 rounded-2xl bg-[#5B3F8C] text-white font-black text-lg shadow-lg active:scale-[.99]">{mode==="register"?"建立帳號並寄驗證碼":"寄送登入驗證碼"}</button>
            <p className="text-xs text-slate-400 leading-relaxed">手機號碼是您的登入帳號，不設定密碼。驗證碼會寄到 Email；驗證成功後此裝置會保留登入狀態。</p>
          </div> : <div className="space-y-5 text-center">
            <div className="text-slate-500 text-sm">驗證碼已寄至 <b>{masked}</b></div>
            <input value={form.code} onChange={e=>set("code",e.target.value.replace(/\D/g,'').slice(0,6))} inputMode="numeric" maxLength="6" placeholder="000000" className="w-full text-center tracking-[.35em] text-3xl font-black px-4 py-5 rounded-2xl border border-violet-200 bg-violet-50 outline-none" />
            <button onClick={verify} className="w-full py-4 rounded-2xl bg-[#5B3F8C] text-white font-black text-lg">確認登入</button>
            <button onClick={()=>setStep("form")} className="text-sm text-slate-400 underline">返回重新輸入</button>
          </div>}
        </div>
      </Shell>;
    }

    function PaymentModal({order, onClose, onDone}) {
      const today = new Date().toISOString().slice(0,10);
      const [form, setForm] = useState({transferDate:today, amount:String(order.totalAmount), last5:""});
      const [loading,setLoading] = useState(false);
      const [error,setError] = useState("");
      async function submit(){
        setLoading(true);setError("");
        try{
          const token=localStorage.getItem(USER_TOKEN_KEY);
          await api("report_payment",{sessionToken:token,orderId:order.orderId,...form});
          onDone();
        }catch(e){setError(e.message)}finally{setLoading(false)}
      }
      return <div className="fixed inset-0 z-40 bg-black/55 backdrop-blur-sm flex items-end sm:items-center justify-center">
        {loading && <Loading text="正在送出匯款回報..."/>}
        <div className="bg-white w-full max-w-md rounded-t-[2rem] sm:rounded-[2rem] p-6 max-h-[90vh] overflow-y-auto">
          <div className="flex justify-between items-center mb-5"><h3 className="text-xl font-black">回報已匯款</h3><button onClick={onClose} className="w-9 h-9 rounded-full bg-slate-100">✕</button></div>
          <Notice>這一步只會通知執秘核帳，<b>不會產生 QR Code</b>。必須等執秘確認真正入帳後才會出票。</Notice>
          {error && <div className="mt-4"><Notice type="error">{error}</Notice></div>}
          <div className="space-y-4 mt-5">
            <div><label className="text-sm font-bold">匯款日期</label><input type="date" value={form.transferDate} onChange={e=>setForm(f=>({...f,transferDate:e.target.value}))} className="mt-1 w-full p-4 rounded-2xl border border-slate-200"/></div>
            <div><label className="text-sm font-bold">實際匯款金額</label><input inputMode="numeric" value={form.amount} onChange={e=>setForm(f=>({...f,amount:e.target.value}))} className="mt-1 w-full p-4 rounded-2xl border border-slate-200"/></div>
            <div><label className="text-sm font-bold">匯款帳號末五碼</label><input inputMode="numeric" maxLength="5" value={form.last5} onChange={e=>setForm(f=>({...f,last5:e.target.value.replace(/\D/g,'').slice(0,5)}))} placeholder="例如 58231" className="mt-1 w-full p-4 rounded-2xl border border-slate-200 text-xl font-black tracking-widest"/></div>
            <button onClick={submit} className="w-full py-4 bg-amber-500 text-white rounded-2xl font-black text-lg">我已匯款，通知執秘確認</button>
          </div>
        </div>
      </div>
    }

    function BuyerDashboard({config,user,onLogout}) {
      const [orders,setOrders]=useState([]);
      const [qty,setQty]=useState(1);
      const [receiptTitle,setReceiptTitle]=useState(`${user.name}${user.title}`);
      const [paymentOrder,setPaymentOrder]=useState(null);
      const [loading,setLoading]=useState(false);
      const [error,setError]=useState("");
      const token=localStorage.getItem(USER_TOKEN_KEY);
      async function refresh(){
        try{const r=await api("list_my_orders",{sessionToken:token});setOrders(r.data||[])}catch(e){setError(e.message)}
      }
      useEffect(()=>{refresh()},[]);
      async function createOrder(){
        setLoading(true);setError("");
        try{await api("create_order",{sessionToken:token,quantity:qty,receiptTitle});await refresh();}
        catch(e){setError(e.message)}finally{setLoading(false)}
      }
      const total=qty*Number(config.ticketPrice||0);

      return <Shell config={config}>
        {loading && <Loading text="正在建立訂單..."/>}
        {paymentOrder && <PaymentModal order={paymentOrder} onClose={()=>setPaymentOrder(null)} onDone={()=>{setPaymentOrder(null);refresh()}}/>}
        <div className="flex items-center justify-between mb-4">
          <div><div className="text-xs text-slate-400">歡迎回來</div><div className="font-black text-lg">{user.name}{user.title}</div></div>
          <button onClick={onLogout} className="px-3 py-2 rounded-xl bg-white border text-xs font-bold text-slate-500">登出</button>
        </div>
        {error && <div className="mb-4"><Notice type="error">{error}</Notice></div>}

        <section className="bg-white rounded-3xl p-6 border border-violet-100 shadow-sm">
          <div className="text-sm font-bold text-[#5B3F8C]">購買扶輪日票券</div>
          <div className="mt-1 text-xs text-slate-400">每張 {money(config.ticketPrice)}</div>
          <div className="flex items-center justify-between mt-5 bg-slate-50 rounded-2xl p-3">
            <button onClick={()=>setQty(q=>Math.max(1,q-1))} className="w-12 h-12 rounded-xl bg-white shadow font-black text-2xl">−</button>
            <div className="text-center"><div className="text-3xl font-black">{qty}</div><div className="text-[10px] text-slate-400">張票券</div></div>
            <button onClick={()=>setQty(q=>Math.min(config.maxTicketsPerOrder||20,q+1))} className="w-12 h-12 rounded-xl bg-white shadow font-black text-2xl">＋</button>
          </div>
          <div className="mt-4"><label className="text-xs font-bold text-slate-500">收據抬頭</label><input value={receiptTitle} onChange={e=>setReceiptTitle(e.target.value)} className="w-full mt-1 p-3 rounded-xl border border-slate-200"/></div>
          <div className="flex justify-between items-end mt-5"><div className="text-sm text-slate-500">應付總額</div><div className="text-2xl font-black text-[#5B3F8C]">{money(total)}</div></div>
          <button onClick={createOrder} disabled={!config.ticketPrice} className="w-full mt-5 py-4 rounded-2xl bg-[#5B3F8C] disabled:bg-slate-300 text-white font-black text-lg">建立購票訂單</button>
        </section>

        <section className="mt-6">
          <div className="flex items-center justify-between mb-3"><h2 className="font-black text-lg">我的訂單</h2><button onClick={refresh} className="text-xs font-bold text-[#5B3F8C]">更新</button></div>
          {!orders.length ? <div className="bg-white rounded-2xl p-6 text-center text-slate-400 text-sm">目前沒有訂單</div> : <div className="space-y-4">
            {orders.map(o=>{
              const sm=statusMap[o.status]||[o.status,"bg-slate-100"];
              return <div key={o.orderId} className="bg-white rounded-3xl border border-slate-100 p-5 shadow-sm">
                <div className="flex justify-between gap-3"><div><div className="font-mono text-xs text-slate-400">{o.orderId}</div><div className="font-black mt-1">{o.quantity} 張 · {money(o.totalAmount)}</div></div><span className={`h-fit text-[11px] font-black px-3 py-1.5 rounded-full ${sm[1]}`}>{sm[0]}</span></div>
                <div className="text-xs text-slate-400 mt-2">建立：{o.createdAt}</div>
                {o.status === "WAITING_PAYMENT" && <div className="mt-4">
                  <div className="bg-violet-50 rounded-2xl p-4 text-sm leading-7">
                    <div><b>銀行：</b>{config.bankName || "尚未設定"}</div><div><b>戶名：</b>{config.bankAccountName || "尚未設定"}</div><div><b>帳號：</b>{config.bankAccount || "尚未設定"}</div>
                  </div>
                  <button onClick={()=>setPaymentOrder(o)} className="w-full mt-3 py-3 rounded-xl bg-amber-500 text-white font-black">我已完成匯款</button>
                </div>}
                {o.status === "PAYMENT_REPORTED" && <div className="mt-4"><Notice>已通知執秘核帳。確認入帳前不會產生 QR Code。</Notice></div>}
                {o.status === "PAYMENT_ISSUE" && <div className="mt-4"><Notice type="error">{o.note || "款項需要再次確認"}</Notice><button onClick={()=>setPaymentOrder(o)} className="w-full mt-3 py-3 rounded-xl bg-rose-600 text-white font-black">重新回報匯款</button></div>}
                {o.status === "PAID" && <div className="mt-4">
                  {o.receiptId && <div className="text-xs text-emerald-700 font-bold mb-3">電子收據：{o.receiptId}</div>}
                  <div className="grid gap-2">{(o.tickets||[]).map(t=><a key={t.ticketId} href={t.url} target="_blank" className="flex items-center justify-between p-3 rounded-2xl bg-violet-50 border border-violet-100"><div><div className="font-black text-[#5B3F8C]">{t.name}</div><div className="text-[10px] font-mono text-slate-400">{t.ticketId}</div></div><span className="text-[#5B3F8C] font-black">開啟票券 ›</span></a>)}</div>
                </div>}
              </div>
            })}
          </div>}
        </section>
        <div className="mt-8 text-center"><a href="?admin=1" className="text-[10px] text-slate-300">執秘管理入口</a></div>
      </Shell>;
    }

    function Admin({config}) {
      const [token,setToken]=useState(localStorage.getItem(ADMIN_TOKEN_KEY)||"");
      const [password,setPassword]=useState("");
      const [pending,setPending]=useState([]);
      const [loading,setLoading]=useState(false);
      const [error,setError]=useState("");

      async function verifyToken(t=token){
        if(!t)return false;
        try{await api("admin_session",{adminToken:t});return true}catch(e){localStorage.removeItem(ADMIN_TOKEN_KEY);setToken("");return false}
      }
      async function load(t=token){
        setLoading(true);setError("");
        try{const r=await api("admin_pending_payments",{adminToken:t});setPending(r.data||[])}catch(e){setError(e.message)}finally{setLoading(false)}
      }
      useEffect(()=>{ if(token) verifyToken(token).then(ok=>ok&&load(token)); },[]);
      async function login(){
        setLoading(true);setError("");
        try{const r=await api("admin_login",{password});localStorage.setItem(ADMIN_TOKEN_KEY,r.adminToken);setToken(r.adminToken);await load(r.adminToken)}catch(e){setError(e.message)}finally{setLoading(false)}
      }
      async function confirm(o){
        if(!window.confirm(`確認銀行已收到 ${money(o.totalAmount)}，並正式產生 ${o.quantity} 張 QR 入場券？`))return;
        setLoading(true);setError("");
        try{const r=await api("admin_confirm_payment",{adminToken:token,orderId:o.orderId});if(r.warnings?.length)alert("已完成出票，但：\n"+r.warnings.join("\n"));else alert("✅ 已確認入帳，收據與票券已寄出");await load(token)}catch(e){setError(e.message)}finally{setLoading(false)}
      }

      return <Shell config={config}>
        {loading && <Loading text="執秘資料處理中..."/>}
        <div className="mb-4"><a href="./" className="text-sm font-bold text-[#5B3F8C]">← 返回購票首頁</a></div>
        {!token ? <div className="bg-white p-6 rounded-3xl border shadow-sm max-w-md mx-auto">
          <h2 className="text-2xl font-black">執秘管理端</h2><p className="text-sm text-slate-400 mt-1">核對匯款後，才能正式建立 QR Code 入場券。</p>
          {error&&<div className="mt-4"><Notice type="error">{error}</Notice></div>}
          <input type="password" value={password} onChange={e=>setPassword(e.target.value)} placeholder="管理密碼" className="w-full mt-5 p-4 rounded-2xl border"/>
          <button onClick={login} className="w-full mt-3 py-4 rounded-2xl bg-[#5B3F8C] text-white font-black">登入管理端</button>
        </div> : <>
          <div className="flex justify-between items-center mb-4"><div><h2 className="text-2xl font-black">待核帳款項</h2><p className="text-xs text-slate-400">購買人已回報匯款，尚未出票</p></div><button onClick={()=>load(token)} className="px-3 py-2 bg-white rounded-xl border text-xs font-bold">更新</button></div>
          {error&&<div className="mb-4"><Notice type="error">{error}</Notice></div>}
          {!pending.length?<div className="bg-white rounded-3xl p-8 text-center text-slate-400">目前沒有待核帳資料</div>:<div className="space-y-4">{pending.map(o=><div key={o.orderId} className="bg-white rounded-3xl p-5 border shadow-sm">
            <div className="flex justify-between"><div><div className="font-black text-lg">{o.buyerName}{o.title}</div><div className="text-xs font-mono text-slate-400">{o.orderId}</div></div><div className="text-right"><div className="text-xs text-slate-400">應收</div><div className="text-xl font-black text-[#5B3F8C]">{money(o.totalAmount)}</div></div></div>
            <div className="grid grid-cols-2 gap-3 mt-4 text-sm">
              <div className="bg-slate-50 rounded-xl p-3"><div className="text-[10px] text-slate-400">張數</div><b>{o.quantity} 張</b></div>
              <div className={`rounded-xl p-3 ${Number(o.transferAmount)===Number(o.totalAmount)?"bg-emerald-50":"bg-rose-50"}`}><div className="text-[10px] text-slate-400">回報金額</div><b>{money(o.transferAmount)}</b></div>
              <div className="bg-slate-50 rounded-xl p-3"><div className="text-[10px] text-slate-400">匯款日期</div><b>{o.transferDate}</b></div>
              <div className="bg-amber-50 rounded-xl p-3"><div className="text-[10px] text-slate-400">帳號末五碼</div><b className="text-lg tracking-widest">{o.last5}</b></div>
            </div>
            <div className="mt-3 text-xs text-slate-400">{o.phone} · {o.email}</div>
            <button onClick={()=>confirm(o)} className="w-full mt-4 py-4 rounded-2xl bg-emerald-600 text-white font-black text-lg">✓ 確認銀行已入帳並正式出票</button>
          </div>)}</div>}
        </>}
      </Shell>;
    }

    function App(){
      const params=new URLSearchParams(location.search);
      const ticketId=params.get("ticket");
      const ticketToken=params.get("k");
      const adminMode=params.get("admin")==="1";
      const [config,setConfig]=useState(null);
      const [user,setUser]=useState(null);
      const [checking,setChecking]=useState(true);

      useEffect(()=>{
        api("get_config").then(r=>setConfig(r.data)).catch(()=>setConfig({eventName:"臺中惠民扶輪社 扶輪日",ticketTitle:"扶輪日入場券",ticketPrice:0,maxTicketsPerOrder:20}));
      },[]);

      useEffect(()=>{
        if(ticketId||adminMode){setChecking(false);return;}
        const t=localStorage.getItem(USER_TOKEN_KEY);
        if(!t){setChecking(false);return;}
        api("session_me",{sessionToken:t}).then(r=>setUser(r.user)).catch(()=>localStorage.removeItem(USER_TOKEN_KEY)).finally(()=>setChecking(false));
      },[]);

      if(ticketId&&ticketToken)return <TicketPublic ticketId={ticketId} token={ticketToken} config={config}/>;
      if(adminMode)return <Admin config={config}/>;
      if(checking||!config)return <Loading/>;
      if(!user)return <Auth config={config} onAuthed={(u)=>setUser(u)}/>;
      return <BuyerDashboard config={config} user={user} onLogout={()=>{const t=localStorage.getItem(USER_TOKEN_KEY);api("logout",{sessionToken:t}).catch(()=>{});localStorage.removeItem(USER_TOKEN_KEY);setUser(null)}}/>;
    }

    ReactDOM.createRoot(document.getElementById("root")).render(<App/>);
  </script>
</body>
</html>
